# Copiar como .env y completar. NUNCA subir el .env al repositorio.

# Conexion a PostgreSQL (base propia de este servicio)
DATABASE_URL=postgresql://conciliador:CLAVE@localhost:5432/conciliador

# Clave para firmar las cookies de sesion (generar una larga y aleatoria)
CLAVE_SESION=cambiar-por-una-clave-larga

# Primer usuario administrador (se crea al inicializar la base)
ADMIN_EMAIL=admin@conciliador.ejemplo
ADMIN_CLAVE=cambiar-esta-clave

# Token compartido para las llamadas internas entre servicios
TOKEN_SERVICIO=cambiar-por-un-token-largo

# URLs de los otros dos servicios (para sincronizar la cadena)
URL_PYME=http://servicio-pyme:8001
URL_BANCO=http://servicio-banco:8002

# Carpeta del volumen para archivos recibidos (en Coolify, el punto de montaje)
DIR_DATOS=/datos

# Puerto (en Coolify lo inyecta la plataforma)
PORT=8000

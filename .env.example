# Configuracion de la plataforma. Se copia como .env y se ajusta lo que haga
# falta: todas las variables tienen un valor por defecto, asi que el sistema
# levanta sin configurar nada.
#
# Los valores de este archivo son de EJEMPLO y estan pensados para una
# instalacion de prueba. Cambiar las claves antes de usarlo con informacion
# real. El archivo .env no se sube al repositorio.

# Base de datos: usuario y clave que se crean en el primer arranque.
USUARIO_BASE_DATOS=conciliacion
CLAVE_BASE_DATOS=conciliacion

# Clave con la que cada servicio firma la cookie de sesion.
CLAVE_SESION_PYME=sesion-pyme-de-ejemplo
CLAVE_SESION_BANCO=sesion-banco-de-ejemplo
CLAVE_SESION_CONCILIADOR=sesion-conciliador-de-ejemplo

# Token de la API interna: tiene que ser el mismo en los tres servicios.
TOKEN_SERVICIO=token-interno-de-ejemplo

# Primer usuario de cada servicio (se crea al inicializar su base).
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_CLAVE=conciliacion2026

# Dominios publicos: solo para Coolify. Si se dejan comentados, Coolify
# genera uno automaticamente para cada servicio.
# SERVICE_FQDN_PYME_8001=https://pyme.tudominio.com
# SERVICE_FQDN_BANCO_8002=https://banco.tudominio.com
# SERVICE_FQDN_CONCILIADOR_8000=https://conciliador.tudominio.com
